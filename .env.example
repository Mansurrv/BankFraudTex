ORBIT_PORT=8080
ORBIT_BRAND=FFBI
ORBIT_LOCAL_TEST=true
ORBIT_POSTGRES_PASSWORD=orbit-postgres-demo
ORBIT_NEO4J_PASSWORD=orbit-neo4j-demo
# For a bank deployment, configure TLS, fresh secrets, and SMTP verification.
# ORBIT_LOCAL_TEST=false
# ORBIT_SECURE_COOKIES=true
# ORBIT_REGISTRATION_DISABLED=true
# ORBIT_ORIGIN=https://example.com
# ORBIT_CORPORATE_DOMAIN=bank.example
# ORBIT_SMTP_ADDR=smtp.bank.example:587
# ORBIT_SMTP_FROM=ffbi@bank.example
# ORBIT_SMTP_USERNAME=
# ORBIT_SMTP_PASSWORD=
# ORBIT_USERS='[{"name":"admin@bank.example","role":"administrator","password":"replace-with-a-strong-password"}]'
# Optional AI intent router
# ORBIT_LLM_BASE_URL=https://provider.example/v1
# ORBIT_LLM_MODEL=your-model
# ORBIT_LLM_API_KEY=
